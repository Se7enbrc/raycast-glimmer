{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigestsToSemver"],
  "dependencyDashboard": true,
  "automerge": false,
  "timezone": "America/New_York",
  "schedule": ["before 9am on monday"],
  "separateMajorMinor": false,
  "separateMultipleMajor": false,
  "separateMinorPatch": false,
  "prConcurrentLimit": 1,
  "branchConcurrentLimit": 1,
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "groupName": "dependencies",
      "groupSlug": "all",
      "commitMessagePrefix": "build(deps):"
    },
    {
      "description": "Match @raycast/eslint-config's TypeScript peer range; review when that config supports newer compilers.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": ">=4.8.4 <6.1.0"
    }
  ]
}
